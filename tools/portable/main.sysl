@no_alloc
import sh.sysl.spi.{Bus,Device,ChipSelect,Config,Error,device,config}
extern "spi_probe_byte" probe_byte(byte: u8) -> u8
struct Port
end Port
impl Bus for Port
    configure(*self, cfg: Config) -> Result[unit,Error] = Ok(())
    exchange(*self, byte: u8) -> Result[u8,Error] = Ok(probe_byte(byte))
struct Pin
end Pin
impl ChipSelect for Pin
    set_active(*self, active: bool) -> Result[unit,Error] = Ok(())
@export("spi_probe")
probe() -> int
    var d = device(Port(),Pin(),config(1000000))
    if d.select().is_err() then return 1
    var bytes: [8]u8
    if d.read(bytes[..]).is_err() || d.write(bytes[..]).is_err() then return 2
    if d.deselect().is_err() then return 3
    if d.transaction(t -> t.exchange(0x40)).is_err() then return 4
    0
